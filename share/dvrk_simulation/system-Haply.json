{
    "$id": "dvrk-system.schema.json",
    "$version": "1",
    "component_manager": {
        "components": [
            {
                "shared-library": "sawGenericInput",
                "class-name": "mtsEvdev",
                "constructor-arg": {
                    "Name": "Pedals",
                    "Period": 0.002
                },
                "configure-parameter": "sawGenericInput-pedals.json"
            },
            {
                "shared-library": "sawHaplyService",
                "class-name": "mtsHaply",
                "constructor-arg": {
                    "Name": "Haply"
                },
                "configure-parameter": "sawHaplyService-JHU-Imerse-0699-069E.json"
            },
            {
                "shared-library": "dvrk_arm_from_ros",
                "class-name": "dvrk_psm_from_ros",
                "constructor-arg": {
                    "Name": "PSM1",
                    "Period": 0.01
                }
            },
            {
                "shared-library": "dvrk_arm_from_ros",
                "class-name": "dvrk_psm_from_ros",
                "constructor-arg": {
                    "Name": "PSM2",
                    "Period": 0.01
                }
            },
            {
                "shared-library": "dvrk_arm_from_ros",
                "class-name": "dvrk_psm_from_ros",
                "constructor-arg": {
                    "Name": "PSM3",
                    "Period": 0.01
                }
            },
            {
                "shared-library": "dvrk_arm_from_ros",
                "class-name": "dvrk_arm_from_ros",
                "constructor-arg": {
                    "Name": "ECM",
                    "Period": 0.01
                }
            }
        ]
    },
    "arms": [
        {
            "name": "MTML",
            "type": "MTM_GENERIC",
            "component": "Haply",
            "interface": "MTML"
        },
        {
            "name": "MTMR",
            "type": "MTM_GENERIC",
            "component": "Haply",
            "interface": "MTMR"
        },
        {
            "name": "PSM1",
            "type": "PSM_GENERIC",
            "component": "PSM1",
            "interface": "PSM1",
            "skip_ROS_bridge": true
        },
        {
            "name": "PSM2",
            "type": "PSM_GENERIC",
            "component": "PSM2",
            "interface": "PSM2",
            "skip_ROS_bridge": true
        },
        {
            "name": "PSM3",
            "type": "PSM_GENERIC",
            "component": "PSM3",
            "interface": "PSM3",
            "skip_ROS_bridge": true
        },
        {
            "name": "ECM",
            "type": "ECM_GENERIC",
            "component": "ECM",
            "interface": "ECM",
            "skip_ROS_bridge": true
        }
    ],
    "consoles": [
        {
            "name": "console",
            "input_type": "COMPONENTS",
            "clutch": {
                "component": "Pedals",
                "interface": "Clutch"
            },
            "camera": {
                "component": "Pedals",
                "interface": "Camera"
            },
            "operator_present": {
                "component": "Pedals",
                "interface": "OperatorPresent"
            },
            "teleop_PSMs": [
                {
                    "MTM": "MTMR",
                    "PSM": "PSM1",
                    "configure_parameter": {
                        "MTM_is_haptic": true,
                        "align_MTM": false,
                        "start_gripper_threshold": 0.0,
                        "scale": 0.4
                    }
                },
                {
                    "MTM": "MTML",
                    "PSM": "PSM2",
                    "configure_parameter": {
                        "MTM_is_haptic": true,
                        "align_MTM": false,
                        "start_gripper_threshold": 0.0,
                        "scale": 0.4
                    }
                },
                {
                    "MTM": "MTML",
                    "PSM": "PSM3",
                    "configure_parameter": {
                        "MTM_is_haptic": true,
                        "align_MTM": false,
                        "start_gripper_threshold": 0.0,
                        "scale": 0.4
                    }
                }
            ],
            "teleop_ECMs": [
                {
                    "MTML": "MTML",
                    "MTMR": "MTMR",
                    "ECM": "ECM",
                    "configure_parameter": {
                        "check_MTMs_workspace": false,
                        "haptic_feedback_ratio": 0.0
                    }
                }
            ]
        }
    ]
}
